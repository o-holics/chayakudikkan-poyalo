rules_version = '2';

// chayakudikanpooyalo — authoritative state is written by the Admin SDK only
// (those paths are `allow write: if false` here). Clients read in realtime and
// write just their own social data.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Server-owned: cafes + nearby cache ──────────────────────────
    match /teaSpots/{spotId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /nearbyCache/{geohash} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Server-owned: matching pools (counts only, no private data) ──
    match /matchPools/{areaKey} {
      allow read: if signedIn();
      allow write: if false;
      match /waiting/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ── Server-owned: "people looked here today" counters ───────────
    match /interest/{spotId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Tables: readable by their members; chat + presence by members ─
    match /teaTables/{tableId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/teaTables/$(tableId)).data.memberUids;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/teaTables/$(tableId)).data.memberUids
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /presence/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/teaTables/$(tableId)).data.memberUids;
        allow write: if isUser(uid)
          && request.auth.uid in get(/databases/$(database)/documents/teaTables/$(tableId)).data.memberUids;
      }
    }

    // ── Profiles ───────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if signedIn();

      // Self-writes limited to the calm profile fields. Server fields
      // (activeTableId, stats, onboardedAt) are Admin-only.
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(
          ['uid', 'displayName', 'areaLabel', 'homePoint', 'sizeMin', 'sizeMax', 'createdAt']
        );
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['displayName', 'areaLabel', 'homePoint', 'sizeMin', 'sizeMax']
        );
      allow delete: if false;

      match /blocks/{other} {
        allow read: if isUser(uid);
        allow write: if isUser(uid);
      }
      match /history/{tableId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // ── Reports: fire and forget ───────────────────────────────────
    match /safetyReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
